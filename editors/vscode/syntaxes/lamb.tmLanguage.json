{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lamb",
  "scopeName": "source.lamb",
  "patterns": [
    { "include": "#comments" },
    { "include": "#colon-command" },
    { "include": "#lambda" },
    { "include": "#backslash" },
    { "include": "#open" },
    { "include": "#section" },
    { "include": "#keyword" },
    { "include": "#definition" },
    { "include": "#magic" },
    { "include": "#punctuation" },
    { "include": "#debruijn-index" },
    { "include": "#variable" }
  ],
  "repository": {
    "comments": {
      "match": "(//)(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.lamb" },
        "2": { "name": "comment.line.double-slash.lamb" }
      }
    },

    "colon-command": {
      "match": "(:)([A-Za-z]+)",
      "captures": {
        "1": { "name": "punctuation.definition.command.lamb" },
        "2": { "name": "keyword.other.command.lamb" }
      }
    },

    "lambda": {
      "name": "meta.function.lambda.lamb",
      "begin": "(\\\\|λ)(?=\\s*(?:(?!(?:open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]]))(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+\\s*\\.|\\.))",
      "beginCaptures": {
        "1": { "name": "keyword.operator.lambda.lamb" }
      },
      "end": "(?!\\s*\\.)(?!\\s*(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+\\s*\\.)",
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_?'/\\-&&[^λ]])(open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]])",
          "name": "keyword.control.lamb"
        },
        {
          "match": "(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+(?=\\s*\\.)",
          "name": "variable.parameter.lamb"
        },
        {
          "match": "\\.",
          "name": "punctuation.separator.lambda.lamb"
        }
      ]
    },

    "backslash": {
      "match": "(\\\\|λ)",
      "name": "keyword.operator.lambda.lamb"
    },

    "open": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_?'/\\-])(open)((?:\\s+(?!(?:open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]]))(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+)+)(\\s+)(in)(?![\\p{L}\\p{N}_?'/\\-])",
          "captures": {
            "1": { "name": "keyword.control.open.lamb" },
            "2": { "name": "entity.name.namespace.lamb" },
            "4": { "name": "keyword.control.in.lamb" }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_?'/\\-])(open)((?:\\s+(?!(?:open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]]))(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+)+)(?=\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.open.lamb" },
            "2": { "name": "entity.name.namespace.lamb" }
          }
        }
      ]
    },

    "section": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_?'/\\-])(section)((?:\\s+(?!(?:open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]]))(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+))?(?=\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.section.lamb" },
            "2": { "name": "entity.name.namespace.lamb" }
          }
        }
      ]
    },

    "keyword": {
      "match": "(?<![\\p{L}\\p{N}_?'/\\-&&[^λ]])(open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]])",
      "captures": {
        "1": { "name": "keyword.control.lamb" }
      }
    },

    "definition": {
      "name": "meta.function.definition.lamb",
      "begin": "(?<![\\p{L}\\p{N}_?'/\\-.])((?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+)(?=(?:\\s+(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+)*\\s*=)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.definition.lamb" }
      },
      "end": "(?=\\s*=)",
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_?'/\\-&&[^λ]])(open|in|section)(?![\\p{L}\\p{N}_?'/\\-&&[^λ]])",
          "name": "keyword.control.lamb"
        },
        { "match": "(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+", "name": "variable.parameter.lamb" }
      ]
    },

    "magic": {
      "match": "#(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))*",
      "name": "support.function.magic.lamb"
    },

    "punctuation": {
      "patterns": [
        { "match": "\\(", "name": "punctuation.section.group.begin.lamb" },
        { "match": "\\)", "name": "punctuation.section.group.end.lamb" },
        { "match": "=", "name": "keyword.operator.assignment.lamb" },
        { "match": ";", "name": "punctuation.terminator.statement.lamb" },
        { "match": "\\.", "name": "punctuation.separator.lambda.lamb" }
      ]
    },

    "debruijn-index": {
      "match": "(?<![\\p{L}\\p{N}_?'/\\-])[0-9]+(?![\\p{L}\\p{N}_?'/\\-])",
      "name": "constant.numeric.debruijn.lamb"
    },

    "variable": {
      "match": "(?![\\p{Nd}/])(?:[\\p{L}\\p{N}_?'\\-&&[^λ]]|/(?!/))+",
      "name": "variable.other.lamb"
    }
  }
}
