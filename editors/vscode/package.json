{
  "name": "lamb-language",
  "displayName": "Lamb",
  "description": "Syntax highlighting, completion and Lean-style Unicode input for the Lamb language.",
  "version": "0.4.0",
  "publisher": "montmorill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsoding/lamb.git"
  },
  "engines": {
    "vscode": "^1.64.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lamb",
    "onCommand:lamb.input.convert",
    "onCommand:lamb.input.insertSymbol"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lamb.input.convert",
        "title": "Convert Unicode Abbreviation",
        "category": "Lamb"
      },
      {
        "command": "lamb.input.insertSymbol",
        "title": "Insert Unicode Symbol",
        "category": "Lamb"
      }
    ],
    "keybindings": [
      {
        "command": "lamb.input.convert",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == lamb && lamb.input.isActive"
      },
      {
        "command": "lamb.input.insertSymbol",
        "key": "ctrl+alt+\\",
        "mac": "cmd+alt+\\",
        "when": "editorTextFocus && editorLangId == lamb"
      }
    ],
    "configurationDefaults": {
      "[lamb]": {
        "editor.tabCompletion": "on"
      }
    },
    "configuration": {
      "title": "Lamb",
      "properties": {
        "lamb.input.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Lean-style Unicode abbreviation input in Lamb files."
        },
        "lamb.input.leader": {
          "type": "string",
          "default": "\\",
          "description": "Single character that starts an abbreviation (default: backslash)."
        },
        "lamb.input.customTranslations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra abbreviations, e.g. {\"foo\": \"☺\"} makes \\foo insert ☺."
        }
      }
    },
    "languages": [
      {
        "id": "lamb",
        "aliases": [
          "Lamb",
          "lamb"
        ],
        "extensions": [
          ".lamb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./lamb.png",
          "dark": "./lamb.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "lamb",
        "scopeName": "source.lamb",
        "path": "./syntaxes/lamb.tmLanguage.json"
      }
    ]
  }
}
