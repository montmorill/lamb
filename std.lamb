id    x   = x;
const x _ = x;

omega x = x x;
Omega = omega omega;

Y f = omega (\x. f (x x));
Z f = omega (\x. f(\v. x x v));

// CBool : a -> a -> a
tru t f = t;
fls t f = f;
and p q = p q fls;
or  p q = p tru q;
not p   = p fls tru;
xor p q = p (not q) q;

// Pair : a -> a -> CBool -> a
pair x y b = b x y;
fst p = p tru;
snd p = p fls;
step f p = pair (f (fst p)) (fst p);

// CNat : (a -> a) -> a -> a
zero f x = x;
succ n f x = f (n f x);
one   = succ zero;
two   = succ one;
three = succ two;
four  = succ three;
five  = succ four;
six   = succ five;
seven = succ six;
eight = succ seven;
nine  = succ eight;
ten   = succ nine;
is-zero n = n (const fls) tru;
is-even n = n not tru;
add m n = n succ m;
mul m n = n (add m) zero;
pow m n = n (mul m) one;
sub m n = n pred m;
pred n = snd (n (step succ) (pair zero zero));

// CList a : (a → r → r) → r → r
nil c n = n;
is-nil xs = xs (\_. _. fls) tru;
cons x xs c n = c x (xs c n);
length xs = xs (const succ) zero;
head xs = xs const nil;
tail xs = snd (l (\h. step (cons h)) (pair nil nil));

trace_list = Y \rec. \xs. isnil xs nil (cons (#trace (head xs))) (rec (tail xs));
